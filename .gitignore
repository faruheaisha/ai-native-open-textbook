# 依赖与构建产物
node_modules/
site/node_modules/
site/docs/.vitepress/dist/
site/docs/.vitepress/cache/
site/docs/.vitepress/.temp/
site/.vptest/
.cache/
dist/

# 上游资料只读快照（约 1.26 GB）：不入库。
# 重建方式见 课程设计基线/research/ 下的检索记录与 scripts/build-catalog.mjs。
upstream/

# 编辑与调试中间产物
scripts/tmp/
scripts/tmp-html.html
site/docs/.vitepress/*.timestamp-*.mjs
site/tmp-*.mjs
*.bak
*.orig
*.rej

# 本地与平台
.env
.env.*
.vercel
.netlify
.wrangler
.DS_Store
Thumbs.db
*.log

# 误下载的杂项文件与临时截图
Proxy
*.png
!site/docs/public/**/*.png
!docs/**/*.png

# 第三方图片的本地镜像（约 570MB）。构建产物，不入库。
# 生成方式：node scripts/mirror-images.mjs（可反复运行续传）
# 索引 mirror-index.json 入库：仓库里没有镜像文件时，生成器会按索引回退到加速通道。
site/docs/public/mirror/

# 原件原样归档（由 build-raw-archive.mjs 生成，部署时随静态站发布；不入源码库）
site/docs/public/raw/
site/docs/public/raw-manifest.json
